# Optional: everything here can also be set on the /settings page, which writes
# to .jevseo.local.json instead. Environment variables always take precedence.
#
# For a deployment, use these — the settings page refuses to write in production.

# TypeSafe — required. Powers every semantic judgment.
# https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional. Pin a model version instead of tracking the jev-latest alias.
# TYPESAFE_MODEL=jev-1.13.0

# DataForSEO — optional. Without these, competitor comparison is skipped and
# everything else still works.
# https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# How long a cached SERP result stays valid, in hours. Default 24.
# Set to 0 to disable caching, which means every analysis spends again.
# SERP_CACHE_TTL_HOURS=24

# Optional: shown in the nav and used for absolute URLs in metadata.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/epergaboni/jevseo
# NEXT_PUBLIC_SITE_URL=https://jevseo.epergaboni.com
